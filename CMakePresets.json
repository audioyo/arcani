{
  "version": 6,
  "cmakeMinimumRequired": { "major": 4, "minor": 4, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-clang-cl",
      "displayName": "Windows x64, clang-cl, Ninja",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang-cl"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux x64, clang, Ninja",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],
  "buildPresets": [
    { "name": "windows-clang-cl", "configurePreset": "windows-clang-cl" },
    { "name": "linux-clang", "configurePreset": "linux-clang" }
  ],
  "testPresets": [
    {
      "name": "windows-clang-cl",
      "configurePreset": "windows-clang-cl",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ],
  "workflowPresets": [
    {
      "name": "windows-clang-cl",
      "steps": [
        { "type": "configure", "name": "windows-clang-cl" },
        { "type": "build", "name": "windows-clang-cl" },
        { "type": "test", "name": "windows-clang-cl" }
      ]
    },
    {
      "name": "linux-clang",
      "steps": [
        { "type": "configure", "name": "linux-clang" },
        { "type": "build", "name": "linux-clang" },
        { "type": "test", "name": "linux-clang" }
      ]
    }
  ]
}
