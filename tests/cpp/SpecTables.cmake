  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    set(_fields "")
    foreach(key swing_hex period_hex start_hex x_hex)
      string(JSON v GET "${_rc}" ${i} ${key})
      _arcani_spec_hexf(v "${v}")
      string(APPEND _fields "${v}, ")
    endforeach()
    string(JSON v GET "${_rc}" ${i} p0)
    _arcani_spec_u64(v "${v}")
    string(APPEND _fields "${v}, ")
    string(JSON v GET "${_rc}" ${i} inv_period_hex)
    _arcani_spec_hexf(v "${v}")
    string(APPEND _fields "${v}, ")
    string(JSON v GET "${_rc}" ${i} fs)
    string(APPEND _fields "${v}u, ")
    string(JSON v GET "${_rc}" ${i} inc_cycle)
    _arcani_spec_u64(v "${v}")
    string(APPEND _fields "${v}, ")
    foreach(key swing_period_hex k_hex)
      string(JSON v GET "${_rc}" ${i} ${key})
      _arcani_spec_hexf(v "${v}")
      string(APPEND _fields "${v}, ")
    endforeach()
    string(JSON v GET "${_rc}" ${i} c0_bits)
    if(NOT v MATCHES "^0x[0-9a-f]+$")
      message(FATAL_ERROR "spec tables: not a hex bit pattern: '${v}'")
    endif()
    string(APPEND h "  {${_fields}UINT64_C(${v})},\n")
  endforeach()
  string(APPEND h "};\n\n")

  string(JSON _bs GET "${vec}" binaural_samples)
  string(JSON n LENGTH "${_bs}")
  string(APPEND h "inline constexpr BinauralSampleVector kBinauralSamples[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    set(_fields "")
    string(JSON fixture GET "${_bs}" ${i} fixture)
    string(JSON case GET "${_bs}" ${i} case)
    string(JSON fs GET "${_bs}" ${i} fs)
    string(JSON swing GET "${_bs}" ${i} swing_hex)
    _arcani_spec_cxx_string(fixture "${fixture}")
    if(case STREQUAL "past_end")
      set(past "true")
    elseif(case STREQUAL "signal")
      set(past "false")
    else()
      message(FATAL_ERROR "spec tables: unknown binaural sample case: '${case}'")
    endif()
    if(swing STREQUAL "none")
      set(has_cycle "false")
    else()
      set(has_cycle "true")
    endif()
    foreach(key left_hex beat_hex center_hex swing_hex period_hex start_hex length_hex)
      string(JSON v GET "${_bs}" ${i} ${key})
      if(v STREQUAL "none")
        set(v "0.0")
      else()
        _arcani_spec_hexf(v "${v}")
      endif()
      string(APPEND _fields ", ${v}")
    endforeach()
    foreach(key inc_left inc_center p0 inc_cycle)
      string(JSON v GET "${_bs}" ${i} ${key})
      if(v STREQUAL "none")
        set(v "0")
      endif()
      _arcani_spec_u64(v "${v}")
      string(APPEND _fields ", ${v}")
    endforeach()
    string(JSON v GET "${_bs}" ${i} k_hex)
    if(v STREQUAL "none")
      set(v "0.0")
    else()
      _arcani_spec_hexf(v "${v}")
    endif()
    string(APPEND _fields ", ${v}")
    foreach(key frames n phase_left phase_center phase_cycle)
      string(JSON v GET "${_bs}" ${i} ${key})
      if(v STREQUAL "none")
        set(v "0")
      endif()
      _arcani_spec_u64(v "${v}")
      string(APPEND _fields ", ${v}")
    endforeach()
    foreach(key c_bits v_bits)
      string(JSON v GET "${_bs}" ${i} ${key})
      if(v STREQUAL "none")
        set(v "0x0")
      elseif(NOT v MATCHES "^0x[0-9a-f]+$")
        message(FATAL_ERROR "spec tables: not a hex bit pattern: '${v}'")
      endif()
      string(APPEND _fields ", UINT64_C(${v})")
    endforeach()
    foreach(key u_units phase_right)
      string(JSON v GET "${_bs}" ${i} ${key})
      _arcani_spec_u64(v "${v}")
      string(APPEND _fields ", ${v}")
    endforeach()
    foreach(key left_bits right_bits)
      string(JSON v GET "${_bs}" ${i} ${key})
      if(NOT v MATCHES "^0x[0-9a-f]+$")
        message(FATAL_ERROR "spec tables: not a hex bit pattern: '${v}'")
      endif()
      string(APPEND _fields ", UINT64_C(${v})")
    endforeach()
    string(APPEND h "  {${fixture}, ${past}, ${fs}u, ${has_cycle}${_fields}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- Rate curves on the theta and gamma rates (Story 2.6)
  string(JSON _lc GET "${vec}" layer_rate_cycles)
  string(JSON n LENGTH "${_lc}")
  string(APPEND h "inline constexpr LayerRateCycleVector kLayerRateCycles[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON _row GET "${_lc}" ${i})  # one row: each key lookup then parses a small object
    string(JSON fixture GET "${_row}" fixture)
    string(JSON layer GET "${_row}" layer)
    string(JSON fs GET "${_row}" fs)
    if(NOT layer MATCHES "^(theta|gamma)$")
      message(FATAL_ERROR "spec tables: unknown rate cycle layer: '${layer}'")
    endif()
    _arcani_spec_cxx_string(fixture "${fixture}")
    _arcani_spec_cxx_string(layer "${layer}")
    set(_fields "")
    foreach(key center_hex swing_hex period_hex start_hex lowest_hex highest_hex)
      string(JSON v GET "${_row}" ${key})
      _arcani_spec_hexf(v "${v}")
      string(APPEND _fields ", ${v}")
    endforeach()
    foreach(key inc_rate p0)
      string(JSON v GET "${_row}" ${key})
      _arcani_spec_u64(v "${v}")
      string(APPEND _fields ", ${v}")
    endforeach()
    string(JSON v GET "${_row}" inv_period_hex)
    _arcani_spec_hexf(v "${v}")
    string(APPEND _fields ", ${v}")
    string(JSON v GET "${_row}" inc_cycle)
    _arcani_spec_u64(v "${v}")
    string(APPEND _fields ", ${v}")
    foreach(key swing_period_hex k_hex)
      string(JSON v GET "${_row}" ${key})
      _arcani_spec_hexf(v "${v}")
      string(APPEND _fields ", ${v}")
    endforeach()
    string(JSON v GET "${_row}" c0_bits)
    if(NOT v MATCHES "^0x[0-9a-f]+$")
      message(FATAL_ERROR "spec tables: not a hex bit pattern: '${v}'")
    endif()
    string(APPEND _fields ", UINT64_C(${v})")
    string(JSON v GET "${_row}" frames)
    _arcani_spec_u64(v "${v}")
    string(APPEND _fields ", ${v}")
    string(APPEND h "  {${fixture}, ${layer}, ${fs}u${_fields}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  string(JSON _rs GET "${vec}" rate_curve_samples)
  string(JSON n LENGTH "${_rs}")
  string(APPEND h "inline constexpr RateCurveSampleVector kRateCurveSamples[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON _row GET "${_rs}" ${i})  # one row: each key lookup then parses a small object
    string(JSON fixture GET "${_row}" fixture)
    string(JSON case GET "${_row}" case)
    string(JSON fs GET "${_row}" fs)
    string(JSON shape GET "${_row}" theta_shape)
    string(JSON coupling GET "${_row}" coupling)
    string(JSON theta_swing GET "${_row}" theta_swing_hex)
    string(JSON gamma_swing GET "${_row}" gamma_swing_hex)
    _arcani_spec_cxx_string(fixture "${fixture}")
    if(case STREQUAL "past_end")
      set(past "true")
    elseif(case STREQUAL "signal")
      set(past "false")
    else()
      message(FATAL_ERROR "spec tables: unknown rate curve sample case: '${case}'")
    endif()
    if(shape STREQUAL "none")
      set(has_theta "false")
    else()
      set(has_theta "true")
    endif()
    if(coupling STREQUAL "none")
      set(has_gamma "false")
    elseif(coupling MATCHES "^(uncoupled|smooth_swell|bursts)$")
      set(has_gamma "true")
    else()
      message(FATAL_ERROR "spec tables: unknown rate curve coupling: '${coupling}'")
    endif()
    if(theta_swing STREQUAL "none")
      set(theta_cycle "false")
    else()
      set(theta_cycle "true")
    endif()
    if(gamma_swing STREQUAL "none")
      set(gamma_cycle "false")
    else()
      set(gamma_cycle "true")
    endif()
    _arcani_spec_cxx_string(shape "${shape}")
    _arcani_spec_cxx_string(coupling "${coupling}")
    set(_fields "")
    foreach(key frames n inc_theta inc_theta_envelope inc_gamma inc_gamma_envelope w_units c_units hb_units
                wb_units theta_p0 theta_inc_cycle)
      string(JSON v GET "${_row}" ${key})
      if(v STREQUAL "none")
        set(v "0")
      endif()
      _arcani_spec_u64(v "${v}")
      string(APPEND _fields ", ${v}")
    endforeach()
    string(JSON v GET "${_row}" theta_k_hex)
    if(v STREQUAL "none")
      set(v "0.0")
    else()
      _arcani_spec_hexf(v "${v}")
    endif()
    string(APPEND _fields ", ${v}")
    foreach(key gamma_p0 gamma_inc_cycle)
      string(JSON v GET "${_row}" ${key})
      if(v STREQUAL "none")
        set(v "0")
      endif()
      _arcani_spec_u64(v "${v}")
      string(APPEND _fields ", ${v}")
    endforeach()
    string(JSON v GET "${_row}" gamma_k_hex)
    if(v STREQUAL "none")
      set(v "0.0")
    else()
      _arcani_spec_hexf(v "${v}")
    endif()
    string(APPEND _fields ", ${v}")
    foreach(key phase_theta theta_cycle_phase theta_u phase_theta_envelope phase_gamma gamma_cycle_phase gamma_u
                phase_gamma_envelope)
      string(JSON v GET "${_row}" ${key})
      if(v STREQUAL "none")
        set(v "0")
      endif()
      _arcani_spec_u64(v "${v}")
      string(APPEND _fields ", ${v}")
    endforeach()
    string(JSON v GET "${_row}" factor_bits)
    if(v STREQUAL "none")
      string(APPEND _fields ", false, UINT64_C(0x0)")
    elseif(v MATCHES "^0x[0-9a-f]+$")
      string(APPEND _fields ", true, UINT64_C(${v})")
    else()
      message(FATAL_ERROR "spec tables: not a hex bit pattern: '${v}'")
    endif()
    foreach(key theta_bits gamma_bits bus_bits)
      string(JSON v GET "${_row}" ${key})
      if(NOT v MATCHES "^0x[0-9a-f]+$")
        message(FATAL_ERROR "spec tables: not a hex bit pattern: '${v}'")
      endif()
      string(APPEND _fields ", UINT64_C(${v})")
    endforeach()
    string(APPEND h "  {${fixture}, ${past}, ${fs}u, ${has_theta}, ${theta_cycle}, ${has_gamma}, ${gamma_cycle}, ${shape}, ${coupling}${_fields}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- Loop (Story 2.7)
  string(JSON _lk GET "${vec}" loop_constants)
  foreach(key length_rule whole_samples_rule whole_samples_limit whole_cycles_rule exceeds_rule
              full_render_fixture probe_fixture)
    string(JSON v GET "${_lk}" ${key})
    _arcani_spec_cxx_string(v "${v}")
    string(APPEND h "inline constexpr const char* kLoop_${key} = ${v};\n")
  endforeach()
  foreach(key window_s probe_segment_s)
    string(JSON v GET "${_lk}" ${key})
    _arcani_spec_decimal(v "${v}")
    string(APPEND h "inline constexpr double kLoop_${key} = ${v};\n")
  endforeach()
  string(JSON v GET "${_lk}" probe_seam)
  string(APPEND h "inline constexpr std::uint64_t kLoop_probe_seam = ${v};\n")
  foreach(mode focus learn)
    string(JSON v GET "${_lk}" max_run_time_min ${mode})
    _arcani_spec_decimal(v "${v}")
    string(APPEND h "inline constexpr double kLoop_max_run_time_min_${mode} = ${v};\n")
  endforeach()
  string(APPEND h "\n")

  string(JSON _lw GET "${vec}" loop_whole_samples)
  string(JSON n LENGTH "${_lw}")
  string(APPEND h "inline constexpr LoopWholeSampleVector kLoopWholeSamples[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON _row GET "${_lw}" ${i})
    string(JSON t GET "${_row}" t_hex)
    string(JSON whole GET "${_row}" whole)
    string(JSON n44 GET "${_row}" n_44100)
    string(JSON n48 GET "${_row}" n_48000)
    _arcani_spec_hexf(t "${t}")
    if(whole STREQUAL "yes")
      set(whole "true")
    elseif(whole STREQUAL "no")
      set(whole "false")
    else()
      message(FATAL_ERROR "spec tables: not yes or no: '${whole}'")
    endif()
    _arcani_spec_u64(n44 "${n44}")
    _arcani_spec_u64(n48 "${n48}")
    string(APPEND h "  {${t}, ${whole}, ${n44}, ${n48}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  string(JSON _lc GET "${vec}" loop_compile_cases)
  string(JSON n LENGTH "${_lc}")
  string(APPEND h "inline constexpr LoopCompileVector kLoopCompileCases[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON _row GET "${_lc}" ${i})
    string(JSON result GET "${_row}" result)
    if(result STREQUAL "accepted")
      set(accepted "true")
    elseif(result STREQUAL "rejected")
      set(accepted "false")
    else()
      message(FATAL_ERROR "spec tables: unknown loop compile result: '${result}'")
    endif()
    set(_fields "")
    foreach(key parameter value rule limit)
      string(JSON v GET "${_row}" ${key})
      _arcani_spec_cxx_string(v "${v}")
      string(APPEND _fields ", ${v}")
    endforeach()
    string(JSON fixture GET "${_row}" fixture)
    _arcani_spec_cxx_string(fixture "${fixture}")
    string(APPEND h "  {${fixture}, ${accepted}${_fields}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  string(JSON _lf GET "${vec}" loop_frames)
  string(JSON n LENGTH "${_lf}")
  string(APPEND h "inline constexpr LoopFrameVector kLoopFrames[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON _row GET "${_lf}" ${i})
    string(JSON fixture GET "${_row}" fixture)
    string(JSON fs GET "${_row}" fs)
    _arcani_spec_cxx_string(fixture "${fixture}")
    set(_fields "")
    foreach(key opening_end_frame body_frames end_frame seam_count)
      string(JSON v GET "${_row}" ${key})
      _arcani_spec_u64(v "${v}")
      string(APPEND _fields ", ${v}")
    endforeach()
    string(JSON count LENGTH "${_row}" seam_frames)
    if(count GREATER 32)
      message(FATAL_ERROR "spec tables: more than 32 loop seams: ${count}")
    endif()
    set(_seams "")
    if(count GREATER 0)
      math(EXPR slast "${count} - 1")
      foreach(j RANGE ${slast})
        string(JSON v GET "${_row}" seam_frames ${j})
        _arcani_spec_u64(v "${v}")
        if(j EQUAL 0)
          set(_seams "${v}")
        else()
          string(APPEND _seams ", ${v}")
        endif()
      endforeach()
    endif()
    string(JSON v GET "${_row}" last_pass_frames)
    _arcani_spec_u64(v "${v}")
    string(APPEND h "  {${fixture}, ${fs}u${_fields}, {${_seams}}, ${v}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- Components (Story 3.1)
  string(APPEND h "struct ComponentCoefficientVector { const char* form; double rate_hz; bool has_h; double h; double w; int k; bool has_p; double p; double c; bool has_bound; double bound; };\n")
  string(APPEND h "struct ComponentCaseVector { const char* name; const char* fixture; const char* mute; const char* recipe; std::size_t components; };\n")
  string(APPEND h "struct ComponentVector { const char* case_name; const char* ear; const char* layer; int gamma_mult; int theta_mult; int beat_mult; double center_hz; double low_hz; double high_hz; double level; };\n")
  string(JSON _ck GET "${vec}" component_constants)
  foreach(key level_db threshold level_error frequency_error case_length_s)
    string(JSON v GET "${_ck}" ${key})
    _arcani_spec_decimal(v "${v}")
    string(APPEND h "inline constexpr double kComponent_${key} = ${v};\n")
  endforeach()
  string(JSON v GET "${_ck}" threshold_hex)
  _arcani_spec_hexf(v "${v}")
  string(APPEND h "inline constexpr double kComponent_threshold_binary64 = ${v};\n")
  string(JSON v GET "${_ck}" no_model_rule)
  _arcani_spec_cxx_string(v "${v}")
  string(APPEND h "inline constexpr const char* kComponent_no_model_rule = ${v};\n")
  foreach(key layers ears probe_cases)
    string(JSON n LENGTH "${_ck}" ${key})
    string(APPEND h "inline constexpr const char* kComponent_${key}[] = {")
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON v GET "${_ck}" ${key} ${i})
      _arcani_spec_cxx_string(v "${v}")
      string(APPEND h "${v}, ")
    endforeach()
    string(APPEND h "};\n")
  endforeach()
  string(APPEND h "\n")

  string(JSON _cc GET "${vec}" component_coefficients)
  string(JSON n LENGTH "${_cc}")
  string(APPEND h "inline constexpr ComponentCoefficientVector kComponentCoefficients[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON _row GET "${_cc}" ${i})
    string(JSON form GET "${_row}" form)
    if(NOT form MATCHES "^(smoothed_on_off|sawtooth|burst_gate)$")
      message(FATAL_ERROR "spec tables: unknown component coefficient form: '${form}'")
    endif()
    _arcani_spec_cxx_string(form "${form}")
    string(JSON rate GET "${_row}" rate_hex)
    _arcani_spec_hexf(rate "${rate}")
    string(JSON hv GET "${_row}" h_hex)
    if(hv STREQUAL "none")
      set(hv "false, 0.0")
    else()
      _arcani_spec_hexf(hv "${hv}")
      set(hv "true, ${hv}")
    endif()
    string(JSON w GET "${_row}" w_hex)
    _arcani_spec_hexf(w "${w}")
    string(JSON k GET "${_row}" k)
    string(JSON c GET "${_row}" c)
    _arcani_spec_decimal(c "${c}")
    set(_opt "")
    foreach(key p bound)
      string(JSON v GET "${_row}" ${key})
      if(v STREQUAL "none")
        list(APPEND _opt "false, 0.0")
      else()
        _arcani_spec_decimal(v "${v}")
        list(APPEND _opt "true, ${v}")
      endif()
    endforeach()
    list(GET _opt 0 pv)
    list(GET _opt 1 bv)
    string(APPEND h "  {${form}, ${rate}, ${hv}, ${w}, ${k}, ${pv}, ${c}, ${bv}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  string(JSON _cs GET "${vec}" component_cases)
  string(JSON n LENGTH "${_cs}")
  string(APPEND h "inline constexpr ComponentCaseVector kComponentCases[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON _row GET "${_cs}" ${i})
    string(JSON mute GET "${_row}" mute)
    if(NOT mute MATCHES "^(none|left|right)$")
      message(FATAL_ERROR "spec tables: unknown muted ear: '${mute}'")
    endif()
    set(_fields "")
    foreach(key case fixture mute recipe)
      string(JSON v GET "${_row}" ${key})
      _arcani_spec_cxx_string(v "${v}")
      string(APPEND _fields "${v}, ")
    endforeach()
    string(JSON count GET "${_row}" components)
    string(APPEND h "  {${_fields}${count}u},\n")
  endforeach()
  string(APPEND h "};\n\n")

  string(JSON _cv GET "${vec}" components)
  string(JSON n LENGTH "${_cv}")
  string(APPEND h "inline constexpr ComponentVector kComponents[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON _row GET "${_cv}" ${i})
    string(JSON ear GET "${_row}" ear)
    if(NOT ear MATCHES "^(both|left|right)$")
      message(FATAL_ERROR "spec tables: unknown component ear: '${ear}'")
    endif()
    string(JSON layer GET "${_row}" layer)
    if(NOT layer MATCHES "^(theta_reference|gamma_pac|binaural)$")
      message(FATAL_ERROR "spec tables: unknown component layer: '${layer}'")
    endif()
    set(_fields "")
    foreach(key case ear layer)
      string(JSON v GET "${_row}" ${key})
      _arcani_spec_cxx_string(v "${v}")
      string(APPEND _fields "${v}, ")
    endforeach()
    foreach(key gamma_mult theta_mult beat_mult)
      string(JSON v GET "${_row}" ${key})
      if(NOT v MATCHES "^-?[0-9]+$")
        message(FATAL_ERROR "spec tables: not an integer: '${v}'")
      endif()
      string(APPEND _fields "${v}, ")
    endforeach()
    set(_values "")
    foreach(key center low high level)
      string(JSON v GET "${_row}" ${key})
      _arcani_spec_decimal(v "${v}")
      list(APPEND _values "${v}")
    endforeach()
    list(JOIN _values ", " _values)
    string(APPEND h "  {${_fields}${_values}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- 24-bit rounding (Story 1.4)
  string(JSON n LENGTH "${vec}" quantize_24)
  string(APPEND h "inline constexpr Quantize24Vector kQuantize24[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON rule GET "${vec}" quantize_24 ${i} rule)
    string(JSON label GET "${vec}" quantize_24 ${i} label)
    string(JSON s GET "${vec}" quantize_24 ${i} s_hex)
    string(JSON value GET "${vec}" quantize_24 ${i} value)
    string(JSON bytes GET "${vec}" quantize_24 ${i} bytes)
    if(NOT rule MATCHES "^(clamp|nan|tie|round|zero)$")
      message(FATAL_ERROR "spec tables: unknown 24-bit rounding rule: '${rule}'")
    endif()
    if(NOT value MATCHES "^-?[0-9]+$")
      message(FATAL_ERROR "spec tables: not an integer: '${value}'")
    endif()
    if(NOT bytes MATCHES "^[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]$")
      message(FATAL_ERROR "spec tables: not 3 hex bytes: '${bytes}'")
    endif()
    string(SUBSTRING "${bytes}" 0 2 b0)
    string(SUBSTRING "${bytes}" 2 2 b1)
    string(SUBSTRING "${bytes}" 4 2 b2)
    _arcani_spec_cxx_string(rule "${rule}")
    _arcani_spec_cxx_string(label "${label}")
    _arcani_spec_hexf(s "${s}")
    if(value STREQUAL "-8388608")
      set(value "(-8388607 - 1)")
    endif()
    string(APPEND h "  {${rule}, ${label}, ${s}, ${value}, {0x${b0}u, 0x${b1}u, 0x${b2}u}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  string(APPEND h "}  // namespace arcani::test::spec\n")

  # Rewrite only on change, so an unchanged configure does not rebuild tests.
  set(old "")
  if(EXISTS "${out_file}")
    file(READ "${out_file}" old)
  endif()
  if(NOT old STREQUAL h)
    file(WRITE "${out_file}" "${h}")
  endif()
endfunction()

# Script mode: cmake -DOUT=... -DVECTORS=... -P SpecTables.cmake
if(CMAKE_SCRIPT_MODE_FILE AND CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  arcani_generate_spec_tables("${OUT}" "${VECTORS}")
endif()
