# Generates a C++ header from the signal spec vectors (Story 0.2), so the C++
# tests never carry a vector as a literal. Input, read at configure time with
# file(READ) and string(JSON):
#
#   tests/data/signal_spec_vectors.json   (tools/signal_spec_vectors.py)
#
# Thresholds and ranges are not generated here: the tests read
# tests/tables/*.tsv at run time through the assertion library
# (tests/assertions/tables.hpp, Story 0.3).
#
# Story 1.2 adds kBlockFrames, kBlocks (internal block size) and kStubChain
# (stub chain samples, one row per fixture, sample rate, and index).
# Story 1.5 adds the theta reference columns to kStubChain: has_theta (false
# when the fixture has no theta_reference field, theta carrier "none"),
# theta_carrier_hz (0.0 then), inc_theta, phase_theta, and theta_bits (the
# theta tap, the same in both channels).
# Story 1.4 adds kQuantize24 (24-bit rounding: rule, case, sample, value, and
# the 3 written bytes in file order).
# Story 2.1 adds the theta reference: kThetaOnSharePercent, kThetaEdgeMs, and
# kThetaHalfOnUnits (H), kRatioToPhase (ratio-to-phase rule), kThetaEdges
# (edge length W per rate), kThetaEnvelopes (engine envelope bits and the
# ideal envelope per shape, rate, and phase), and kThetaSamples (per theta
# fixture, sample rate, and index: phases, e, a, and theta tap bits).
#
# Big integers are JSON strings and become UINT64_C literals. Hex float
# strings become C++ hex float literals; "nan", "inf", and "-inf" become
# std::numeric_limits expressions. Decimal sine values become double
# literals. Usable from a CMakeLists.txt and in script mode (cmake -P).

function(_arcani_spec_cxx_string out_var value)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  set(${out_var} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(_arcani_spec_u64 out_var value)
  if(NOT value MATCHES "^[0-9]+$")
    message(FATAL_ERROR "spec tables: not an unsigned integer: '${value}'")
  endif()
  set(${out_var} "UINT64_C(${value})" PARENT_SCOPE)
endfunction()

# A binary64 value written as a hex float, or nan / inf / -inf.
function(_arcani_spec_hexf out_var value)
  if(value STREQUAL "nan")
    set(${out_var} "std::numeric_limits<double>::quiet_NaN()" PARENT_SCOPE)
  elseif(value STREQUAL "inf")
    set(${out_var} "std::numeric_limits<double>::infinity()" PARENT_SCOPE)
  elseif(value STREQUAL "-inf")
    set(${out_var} "(-std::numeric_limits<double>::infinity())" PARENT_SCOPE)
  elseif(value MATCHES "^-?0x[0-9a-f]+(\\.[0-9a-f]*)?p[-+][0-9]+$")
    set(${out_var} "${value}" PARENT_SCOPE)
  else()
    message(FATAL_ERROR "spec tables: not a hex float: '${value}'")
  endif()
endfunction()

# A decimal number (JSON number or decimal string) as a double literal.
function(_arcani_spec_decimal out_var value)
  if(value MATCHES "^-?[0-9]+$")
    set(${out_var} "${value}.0" PARENT_SCOPE)
  elseif(value MATCHES "^-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?$")
    set(${out_var} "${value}" PARENT_SCOPE)
  else()
    message(FATAL_ERROR "spec tables: not a decimal number: '${value}'")
  endif()
endfunction()

function(arcani_generate_spec_tables out_file vectors_json)
  file(READ "${vectors_json}" vec)

  set(h "// Generated by tests/cpp/SpecTables.cmake at configure time. Do not edit.\n")
  get_filename_component(_v "${vectors_json}" NAME)
  string(APPEND h "// Source: ${_v}\n")
  string(APPEND h "#pragma once\n\n#include <cstddef>\n#include <cstdint>\n#include <limits>\n\n")
  string(APPEND h "namespace arcani::test::spec {\n\n")
  string(APPEND h "struct IncrementVector { const char* label; double f_hz; std::uint32_t fs; std::uint64_t inc; };\n")
  string(APPEND h "struct SamplesVector { const char* label; double t_s; std::uint32_t fs; std::uint64_t n; };\n")
  string(APPEND h "struct PhaseStepVector { const char* label; std::uint64_t start; std::uint64_t inc; std::uint64_t steps; std::uint64_t phase; };\n")
  string(APPEND h "struct SineVector { const char* label; std::uint64_t phase; double sine; };\n")
  string(APPEND h "struct CarrierSample { std::uint64_t n; std::uint64_t phase; double sine; };\n")
  string(APPEND h "struct Coefficient { int power; double value; };\n")
  string(APPEND h "struct EngineSineBits { const char* label; std::uint64_t phase; std::uint64_t bits; };\n")
  string(APPEND h "struct BlockVector { std::uint64_t frame; std::uint64_t block; std::uint64_t offset; };\n")
  string(APPEND h "struct Quantize24Vector { const char* rule; const char* label; double s; std::int32_t value; std::uint8_t bytes[3]; };\n")
  string(APPEND h "struct StubChainVector { const char* fixture; bool past_end; std::uint32_t fs; double carrier_left_hz; double beat_rate_hz; double carrier_right_hz; std::uint64_t inc_left; std::uint64_t inc_right; std::uint64_t frames; std::uint64_t n; std::uint64_t phase_left; std::uint64_t phase_right; std::uint64_t left_bits; std::uint64_t right_bits; bool has_theta; double theta_carrier_hz; std::uint64_t inc_theta; std::uint64_t phase_theta; std::uint64_t theta_bits; };\n")
  string(APPEND h "struct RatioToPhaseVector { const char* label; double r; std::uint64_t phase; };\n")
  string(APPEND h "struct ThetaEdgeVector { double rate_hz; std::uint64_t w_units; };\n")
  string(APPEND h "struct ThetaEnvelopeVector { const char* shape; const char* segment; double rate_hz; std::uint64_t w_units; std::uint64_t h_units; std::uint64_t phase; std::uint64_t e_bits; double ideal_e; };\n")
  string(APPEND h "struct ThetaSampleVector { const char* fixture; bool past_end; std::uint32_t fs; const char* shape; double carrier_hz; double rate_hz; double depth_percent; double length_s; std::uint64_t inc_carrier; std::uint64_t inc_rate; std::uint64_t w_units; std::uint64_t h_units; std::uint64_t frames; std::uint64_t n; std::uint64_t phase_carrier; std::uint64_t phase_rate; std::uint64_t e_bits; std::uint64_t a_bits; std::uint64_t theta_bits; };\n\n")

  # ---- increments
  string(JSON n LENGTH "${vec}" increments)
  string(APPEND h "inline constexpr IncrementVector kIncrements[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON label GET "${vec}" increments ${i} label)
    string(JSON case GET "${vec}" increments ${i} case)
    string(JSON f GET "${vec}" increments ${i} f_hex)
    string(JSON fs GET "${vec}" increments ${i} fs)
    string(JSON inc GET "${vec}" increments ${i} inc)
    _arcani_spec_cxx_string(label "${case}: ${label}")
    _arcani_spec_hexf(f "${f}")
    _arcani_spec_u64(inc "${inc}")
    string(APPEND h "  {${label}, ${f}, ${fs}u, ${inc}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- samples
  string(JSON n LENGTH "${vec}" samples)
  string(APPEND h "inline constexpr SamplesVector kSamples[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON label GET "${vec}" samples ${i} label)
    string(JSON case GET "${vec}" samples ${i} case)
    string(JSON t GET "${vec}" samples ${i} t_hex)
    string(JSON fs GET "${vec}" samples ${i} fs)
    string(JSON count GET "${vec}" samples ${i} n)
    _arcani_spec_cxx_string(label "${case}: ${label}")
    _arcani_spec_hexf(t "${t}")
    _arcani_spec_u64(count "${count}")
    string(APPEND h "  {${label}, ${t}, ${fs}u, ${count}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- phase steps
  string(JSON n LENGTH "${vec}" phase_steps)
  string(APPEND h "inline constexpr PhaseStepVector kPhaseSteps[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON label GET "${vec}" phase_steps ${i} label)
    string(JSON start GET "${vec}" phase_steps ${i} start)
    string(JSON inc GET "${vec}" phase_steps ${i} inc)
    string(JSON steps GET "${vec}" phase_steps ${i} steps)
    string(JSON phase GET "${vec}" phase_steps ${i} phase)
    _arcani_spec_cxx_string(label "${label}")
    _arcani_spec_u64(start "${start}")
    _arcani_spec_u64(inc "${inc}")
    _arcani_spec_u64(steps "${steps}")
    _arcani_spec_u64(phase "${phase}")
    string(APPEND h "  {${label}, ${start}, ${inc}, ${steps}, ${phase}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- exact phases
  string(JSON n LENGTH "${vec}" exact_phases)
  string(APPEND h "inline constexpr SineVector kExactPhases[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON label GET "${vec}" exact_phases ${i} label)
    string(JSON phase GET "${vec}" exact_phases ${i} phase)
    string(JSON sine GET "${vec}" exact_phases ${i} sine)
    _arcani_spec_cxx_string(label "${label}")
    _arcani_spec_u64(phase "${phase}")
    _arcani_spec_decimal(sine "${sine}")
    string(APPEND h "  {${label}, ${phase}, ${sine}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- 450 Hz carrier at 44.1 kHz
  string(JSON c_label GET "${vec}" carrier_450_44100 label)
  string(JSON c_f GET "${vec}" carrier_450_44100 f_hz)
  string(JSON c_fs GET "${vec}" carrier_450_44100 fs)
  string(JSON c_inc GET "${vec}" carrier_450_44100 inc)
  _arcani_spec_cxx_string(c_label "${c_label}")
  _arcani_spec_decimal(c_f "${c_f}")
  _arcani_spec_u64(c_inc "${c_inc}")
  string(APPEND h "inline constexpr const char* kCarrierLabel = ${c_label};\n")
  string(APPEND h "inline constexpr double kCarrierHz = ${c_f};\n")
  string(APPEND h "inline constexpr std::uint32_t kCarrierFs = ${c_fs}u;\n")
  string(APPEND h "inline constexpr std::uint64_t kCarrierInc = ${c_inc};\n")
  string(JSON n LENGTH "${vec}" carrier_450_44100 samples)
  string(APPEND h "inline constexpr CarrierSample kCarrierSamples[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON sn GET "${vec}" carrier_450_44100 samples ${i} n)
    string(JSON phase GET "${vec}" carrier_450_44100 samples ${i} phase)
    string(JSON sine GET "${vec}" carrier_450_44100 samples ${i} sine)
    _arcani_spec_u64(sn "${sn}")
    _arcani_spec_u64(phase "${phase}")
    _arcani_spec_decimal(sine "${sine}")
    string(APPEND h "  {${sn}, ${phase}, ${sine}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- engine sine bits (spec algorithm in binary64, exact operation order)
  string(JSON n LENGTH "${vec}" engine_sine_bits)
  string(APPEND h "inline constexpr EngineSineBits kEngineSineBits[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON label GET "${vec}" engine_sine_bits ${i} label)
    string(JSON phase GET "${vec}" engine_sine_bits ${i} phase)
    string(JSON pattern GET "${vec}" engine_sine_bits ${i} bits)
    if(NOT pattern MATCHES "^0x[0-9a-f]+$")
      message(FATAL_ERROR "spec tables: not a hex bit pattern: '${pattern}'")
    endif()
    _arcani_spec_cxx_string(label "${label}")
    _arcani_spec_u64(phase "${phase}")
    string(APPEND h "  {${label}, ${phase}, UINT64_C(${pattern})},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- sine coefficients
  string(JSON n LENGTH "${vec}" sine_coefficients)
  string(APPEND h "inline constexpr Coefficient kSineCoefficients[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON power GET "${vec}" sine_coefficients ${i} power)
    string(JSON hex GET "${vec}" sine_coefficients ${i} hex)
    _arcani_spec_hexf(hex "${hex}")
    string(APPEND h "  {${power}, ${hex}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- internal block size (Story 1.2)
  string(JSON block_frames GET "${vec}" block_frames)
  _arcani_spec_u64(block_frames "${block_frames}")
  string(APPEND h "inline constexpr std::uint64_t kBlockFrames = ${block_frames};\n")
  string(JSON n LENGTH "${vec}" blocks)
  string(APPEND h "inline constexpr BlockVector kBlocks[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON frame GET "${vec}" blocks ${i} frame)
    string(JSON block GET "${vec}" blocks ${i} block)
    string(JSON offset GET "${vec}" blocks ${i} offset)
    _arcani_spec_u64(frame "${frame}")
    _arcani_spec_u64(block "${block}")
    _arcani_spec_u64(offset "${offset}")
    string(APPEND h "  {${frame}, ${block}, ${offset}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- stub chain samples (Story 1.2)
  string(JSON n LENGTH "${vec}" stub_chain)
  string(APPEND h "inline constexpr StubChainVector kStubChain[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    set(_fields "")
    string(JSON fixture GET "${vec}" stub_chain ${i} fixture)
    string(JSON case GET "${vec}" stub_chain ${i} case)
    string(JSON fs GET "${vec}" stub_chain ${i} fs)
    _arcani_spec_cxx_string(fixture "${fixture}")
    if(case STREQUAL "past_end")
      set(past "true")
    elseif(case STREQUAL "signal")
      set(past "false")
    else()
      message(FATAL_ERROR "spec tables: unknown stub chain case: '${case}'")
    endif()
    foreach(key carrier_left_hex beat_rate_hex carrier_right_hex)
      string(JSON v GET "${vec}" stub_chain ${i} ${key})
      _arcani_spec_hexf(v "${v}")
      string(APPEND _fields ", ${v}")
    endforeach()
    foreach(key inc_left inc_right frames n phase_left phase_right)
      string(JSON v GET "${vec}" stub_chain ${i} ${key})
      _arcani_spec_u64(v "${v}")
      string(APPEND _fields ", ${v}")
    endforeach()
    foreach(key left_bits right_bits)
      string(JSON v GET "${vec}" stub_chain ${i} ${key})
      if(NOT v MATCHES "^0x[0-9a-f]+$")
        message(FATAL_ERROR "spec tables: not a hex bit pattern: '${v}'")
      endif()
      string(APPEND _fields ", UINT64_C(${v})")
    endforeach()
    string(JSON v GET "${vec}" stub_chain ${i} theta_carrier_hex)
    if(v STREQUAL "none")
      string(APPEND _fields ", false, 0.0")
    else()
      _arcani_spec_hexf(v "${v}")
      string(APPEND _fields ", true, ${v}")
    endif()
    foreach(key inc_theta phase_theta)
      string(JSON v GET "${vec}" stub_chain ${i} ${key})
      _arcani_spec_u64(v "${v}")
      string(APPEND _fields ", ${v}")
    endforeach()
    string(JSON v GET "${vec}" stub_chain ${i} theta_bits)
    if(NOT v MATCHES "^0x[0-9a-f]+$")
      message(FATAL_ERROR "spec tables: not a hex bit pattern: '${v}'")
    endif()
    string(APPEND _fields ", UINT64_C(${v})")
    string(APPEND h "  {${fixture}, ${past}, ${fs}u${_fields}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- theta reference (Story 2.1)
  string(JSON on_share GET "${vec}" theta_constants on_share_percent)
  string(JSON edge_ms GET "${vec}" theta_constants edge_ms)
  string(JSON h_units GET "${vec}" theta_constants h_units)
  _arcani_spec_decimal(on_share "${on_share}")
  _arcani_spec_decimal(edge_ms "${edge_ms}")
  _arcani_spec_u64(h_units "${h_units}")
  string(APPEND h "inline constexpr double kThetaOnSharePercent = ${on_share};\n")
  string(APPEND h "inline constexpr double kThetaEdgeMs = ${edge_ms};\n")
  string(APPEND h "inline constexpr std::uint64_t kThetaHalfOnUnits = ${h_units};\n\n")

  string(JSON n LENGTH "${vec}" ratio_to_phase)
  string(APPEND h "inline constexpr RatioToPhaseVector kRatioToPhase[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON label GET "${vec}" ratio_to_phase ${i} label)
    string(JSON r GET "${vec}" ratio_to_phase ${i} r_hex)
    string(JSON phase GET "${vec}" ratio_to_phase ${i} phase)
    _arcani_spec_cxx_string(label "${label}")
    _arcani_spec_hexf(r "${r}")
    _arcani_spec_u64(phase "${phase}")
    string(APPEND h "  {${label}, ${r}, ${phase}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  string(JSON n LENGTH "${vec}" theta_edges)
  string(APPEND h "inline constexpr ThetaEdgeVector kThetaEdges[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON rate GET "${vec}" theta_edges ${i} rate_hex)
    string(JSON w GET "${vec}" theta_edges ${i} w_units)
    _arcani_spec_hexf(rate "${rate}")
    _arcani_spec_u64(w "${w}")
    string(APPEND h "  {${rate}, ${w}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  string(JSON n LENGTH "${vec}" theta_envelopes)
  string(APPEND h "inline constexpr ThetaEnvelopeVector kThetaEnvelopes[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON shape GET "${vec}" theta_envelopes ${i} shape)
    string(JSON region GET "${vec}" theta_envelopes ${i} region)
    string(JSON rate GET "${vec}" theta_envelopes ${i} rate_hex)
    string(JSON w GET "${vec}" theta_envelopes ${i} w_units)
    string(JSON hu GET "${vec}" theta_envelopes ${i} h_units)
    string(JSON phase GET "${vec}" theta_envelopes ${i} phase)
    string(JSON e GET "${vec}" theta_envelopes ${i} e_bits)
    string(JSON ideal GET "${vec}" theta_envelopes ${i} ideal_e)
    if(NOT e MATCHES "^0x[0-9a-f]+$")
      message(FATAL_ERROR "spec tables: not a hex bit pattern: '${e}'")
    endif()
    _arcani_spec_cxx_string(shape "${shape}")
    _arcani_spec_cxx_string(region "${region}")
    _arcani_spec_hexf(rate "${rate}")
    _arcani_spec_u64(w "${w}")
    _arcani_spec_u64(hu "${hu}")
    _arcani_spec_u64(phase "${phase}")
    _arcani_spec_decimal(ideal "${ideal}")
    string(APPEND h "  {${shape}, ${region}, ${rate}, ${w}, ${hu}, ${phase}, UINT64_C(${e}), ${ideal}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  string(JSON n LENGTH "${vec}" theta_samples)
  string(APPEND h "inline constexpr ThetaSampleVector kThetaSamples[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    set(_fields "")
    string(JSON fixture GET "${vec}" theta_samples ${i} fixture)
    string(JSON case GET "${vec}" theta_samples ${i} case)
    string(JSON fs GET "${vec}" theta_samples ${i} fs)
    string(JSON shape GET "${vec}" theta_samples ${i} shape)
    _arcani_spec_cxx_string(fixture "${fixture}")
    _arcani_spec_cxx_string(shape "${shape}")
    if(case STREQUAL "past_end")
      set(past "true")
    elseif(case STREQUAL "signal")
      set(past "false")
    else()
      message(FATAL_ERROR "spec tables: unknown theta sample case: '${case}'")
    endif()
    foreach(key carrier_hex rate_hex depth_hex length_hex)
      string(JSON v GET "${vec}" theta_samples ${i} ${key})
      _arcani_spec_hexf(v "${v}")
      string(APPEND _fields ", ${v}")
    endforeach()
    foreach(key inc_carrier inc_rate w_units h_units frames n phase_carrier phase_rate)
      string(JSON v GET "${vec}" theta_samples ${i} ${key})
      _arcani_spec_u64(v "${v}")
      string(APPEND _fields ", ${v}")
    endforeach()
    foreach(key e_bits a_bits theta_bits)
      string(JSON v GET "${vec}" theta_samples ${i} ${key})
      if(NOT v MATCHES "^0x[0-9a-f]+$")
        message(FATAL_ERROR "spec tables: not a hex bit pattern: '${v}'")
      endif()
      string(APPEND _fields ", UINT64_C(${v})")
    endforeach()
    string(APPEND h "  {${fixture}, ${past}, ${fs}u, ${shape}${_fields}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- 24-bit rounding (Story 1.4)
  string(JSON n LENGTH "${vec}" quantize_24)
  string(APPEND h "inline constexpr Quantize24Vector kQuantize24[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON rule GET "${vec}" quantize_24 ${i} rule)
    string(JSON label GET "${vec}" quantize_24 ${i} label)
    string(JSON s GET "${vec}" quantize_24 ${i} s_hex)
    string(JSON value GET "${vec}" quantize_24 ${i} value)
    string(JSON bytes GET "${vec}" quantize_24 ${i} bytes)
    if(NOT rule MATCHES "^(clamp|nan|tie|round|zero)$")
      message(FATAL_ERROR "spec tables: unknown 24-bit rounding rule: '${rule}'")
    endif()
    if(NOT value MATCHES "^-?[0-9]+$")
      message(FATAL_ERROR "spec tables: not an integer: '${value}'")
    endif()
    if(NOT bytes MATCHES "^[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]$")
      message(FATAL_ERROR "spec tables: not 3 hex bytes: '${bytes}'")
    endif()
    string(SUBSTRING "${bytes}" 0 2 b0)
    string(SUBSTRING "${bytes}" 2 2 b1)
    string(SUBSTRING "${bytes}" 4 2 b2)
    _arcani_spec_cxx_string(rule "${rule}")
    _arcani_spec_cxx_string(label "${label}")
    _arcani_spec_hexf(s "${s}")
    if(value STREQUAL "-8388608")
      set(value "(-8388607 - 1)")
    endif()
    string(APPEND h "  {${rule}, ${label}, ${s}, ${value}, {0x${b0}u, 0x${b1}u, 0x${b2}u}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  string(APPEND h "}  // namespace arcani::test::spec\n")

  # Rewrite only on change, so an unchanged configure does not rebuild tests.
  set(old "")
  if(EXISTS "${out_file}")
    file(READ "${out_file}" old)
  endif()
  if(NOT old STREQUAL h)
    file(WRITE "${out_file}" "${h}")
  endif()
endfunction()

# Script mode: cmake -DOUT=... -DVECTORS=... -P SpecTables.cmake
if(CMAKE_SCRIPT_MODE_FILE AND CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  arcani_generate_spec_tables("${OUT}" "${VECTORS}")
endif()
