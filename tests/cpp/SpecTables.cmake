# Generates a C++ header from the signal spec vectors and the interim tables
# (Story 0.2), so the C++ tests never carry a threshold, range, or vector as a
# literal. Inputs, read at configure time with file(READ) and string(JSON):
#
#   tests/data/signal_spec_vectors.json   (tools/signal_spec_vectors.py)
#   tests/tables/thresholds.json
#   tests/tables/ranges.json
#
# Big integers are JSON strings and become UINT64_C literals. Hex float
# strings become C++ hex float literals; "nan", "inf", and "-inf" become
# std::numeric_limits expressions. Decimal sine values become double
# literals. Usable from a CMakeLists.txt and in script mode (cmake -P).

function(_arcani_spec_cxx_string out_var value)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  set(${out_var} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(_arcani_spec_u64 out_var value)
  if(NOT value MATCHES "^[0-9]+$")
    message(FATAL_ERROR "spec tables: not an unsigned integer: '${value}'")
  endif()
  set(${out_var} "UINT64_C(${value})" PARENT_SCOPE)
endfunction()

# A binary64 value written as a hex float, or nan / inf / -inf.
function(_arcani_spec_hexf out_var value)
  if(value STREQUAL "nan")
    set(${out_var} "std::numeric_limits<double>::quiet_NaN()" PARENT_SCOPE)
  elseif(value STREQUAL "inf")
    set(${out_var} "std::numeric_limits<double>::infinity()" PARENT_SCOPE)
  elseif(value STREQUAL "-inf")
    set(${out_var} "(-std::numeric_limits<double>::infinity())" PARENT_SCOPE)
  elseif(value MATCHES "^-?0x[0-9a-f]+(\\.[0-9a-f]*)?p[-+][0-9]+$")
    set(${out_var} "${value}" PARENT_SCOPE)
  else()
    message(FATAL_ERROR "spec tables: not a hex float: '${value}'")
  endif()
endfunction()

# A decimal number (JSON number or decimal string) as a double literal.
function(_arcani_spec_decimal out_var value)
  if(value MATCHES "^-?[0-9]+$")
    set(${out_var} "${value}.0" PARENT_SCOPE)
  elseif(value MATCHES "^-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?$")
    set(${out_var} "${value}" PARENT_SCOPE)
  else()
    message(FATAL_ERROR "spec tables: not a decimal number: '${value}'")
  endif()
endfunction()

function(arcani_generate_spec_tables out_file vectors_json thresholds_json ranges_json)
  file(READ "${vectors_json}" vec)
  file(READ "${thresholds_json}" thr)
  file(READ "${ranges_json}" rng)

  set(h "// Generated by tests/cpp/SpecTables.cmake at configure time. Do not edit.\n")
  get_filename_component(_v "${vectors_json}" NAME)
  get_filename_component(_t "${thresholds_json}" NAME)
  get_filename_component(_r "${ranges_json}" NAME)
  string(APPEND h "// Sources: ${_v}, ${_t}, ${_r}\n")
  string(APPEND h "#pragma once\n\n#include <cstddef>\n#include <cstdint>\n#include <limits>\n\n")
  string(APPEND h "namespace arcani::test::spec {\n\n")
  string(APPEND h "struct IncrementVector { const char* label; double f_hz; std::uint32_t fs; std::uint64_t inc; };\n")
  string(APPEND h "struct SamplesVector { const char* label; double t_s; std::uint32_t fs; std::uint64_t n; };\n")
  string(APPEND h "struct PhaseStepVector { const char* label; std::uint64_t start; std::uint64_t inc; std::uint64_t steps; std::uint64_t phase; };\n")
  string(APPEND h "struct SineVector { const char* label; std::uint64_t phase; double sine; };\n")
  string(APPEND h "struct CarrierSample { std::uint64_t n; std::uint64_t phase; double sine; };\n")
  string(APPEND h "struct Coefficient { int power; double value; };\n")
  string(APPEND h "struct EngineSineBits { const char* label; std::uint64_t phase; std::uint64_t bits; };\n")
  string(APPEND h "struct Threshold { const char* id; double value; const char* unit; };\n")
  string(APPEND h "struct HzRange { const char* id; double min; double max; };\n\n")

  # ---- increments
  string(JSON n LENGTH "${vec}" increments)
  string(APPEND h "inline constexpr IncrementVector kIncrements[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON label GET "${vec}" increments ${i} label)
    string(JSON case GET "${vec}" increments ${i} case)
    string(JSON f GET "${vec}" increments ${i} f_hex)
    string(JSON fs GET "${vec}" increments ${i} fs)
    string(JSON inc GET "${vec}" increments ${i} inc)
    _arcani_spec_cxx_string(label "${case}: ${label}")
    _arcani_spec_hexf(f "${f}")
    _arcani_spec_u64(inc "${inc}")
    string(APPEND h "  {${label}, ${f}, ${fs}u, ${inc}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- samples
  string(JSON n LENGTH "${vec}" samples)
  string(APPEND h "inline constexpr SamplesVector kSamples[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON label GET "${vec}" samples ${i} label)
    string(JSON case GET "${vec}" samples ${i} case)
    string(JSON t GET "${vec}" samples ${i} t_hex)
    string(JSON fs GET "${vec}" samples ${i} fs)
    string(JSON count GET "${vec}" samples ${i} n)
    _arcani_spec_cxx_string(label "${case}: ${label}")
    _arcani_spec_hexf(t "${t}")
    _arcani_spec_u64(count "${count}")
    string(APPEND h "  {${label}, ${t}, ${fs}u, ${count}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- phase steps
  string(JSON n LENGTH "${vec}" phase_steps)
  string(APPEND h "inline constexpr PhaseStepVector kPhaseSteps[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON label GET "${vec}" phase_steps ${i} label)
    string(JSON start GET "${vec}" phase_steps ${i} start)
    string(JSON inc GET "${vec}" phase_steps ${i} inc)
    string(JSON steps GET "${vec}" phase_steps ${i} steps)
    string(JSON phase GET "${vec}" phase_steps ${i} phase)
    _arcani_spec_cxx_string(label "${label}")
    _arcani_spec_u64(start "${start}")
    _arcani_spec_u64(inc "${inc}")
    _arcani_spec_u64(steps "${steps}")
    _arcani_spec_u64(phase "${phase}")
    string(APPEND h "  {${label}, ${start}, ${inc}, ${steps}, ${phase}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- exact phases
  string(JSON n LENGTH "${vec}" exact_phases)
  string(APPEND h "inline constexpr SineVector kExactPhases[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON label GET "${vec}" exact_phases ${i} label)
    string(JSON phase GET "${vec}" exact_phases ${i} phase)
    string(JSON sine GET "${vec}" exact_phases ${i} sine)
    _arcani_spec_cxx_string(label "${label}")
    _arcani_spec_u64(phase "${phase}")
    _arcani_spec_decimal(sine "${sine}")
    string(APPEND h "  {${label}, ${phase}, ${sine}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- 450 Hz carrier at 44.1 kHz
  string(JSON c_label GET "${vec}" carrier_450_44100 label)
  string(JSON c_f GET "${vec}" carrier_450_44100 f_hz)
  string(JSON c_fs GET "${vec}" carrier_450_44100 fs)
  string(JSON c_inc GET "${vec}" carrier_450_44100 inc)
  _arcani_spec_cxx_string(c_label "${c_label}")
  _arcani_spec_decimal(c_f "${c_f}")
  _arcani_spec_u64(c_inc "${c_inc}")
  string(APPEND h "inline constexpr const char* kCarrierLabel = ${c_label};\n")
  string(APPEND h "inline constexpr double kCarrierHz = ${c_f};\n")
  string(APPEND h "inline constexpr std::uint32_t kCarrierFs = ${c_fs}u;\n")
  string(APPEND h "inline constexpr std::uint64_t kCarrierInc = ${c_inc};\n")
  string(JSON n LENGTH "${vec}" carrier_450_44100 samples)
  string(APPEND h "inline constexpr CarrierSample kCarrierSamples[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON sn GET "${vec}" carrier_450_44100 samples ${i} n)
    string(JSON phase GET "${vec}" carrier_450_44100 samples ${i} phase)
    string(JSON sine GET "${vec}" carrier_450_44100 samples ${i} sine)
    _arcani_spec_u64(sn "${sn}")
    _arcani_spec_u64(phase "${phase}")
    _arcani_spec_decimal(sine "${sine}")
    string(APPEND h "  {${sn}, ${phase}, ${sine}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- engine sine bits (spec algorithm in binary64, exact operation order)
  string(JSON n LENGTH "${vec}" engine_sine_bits)
  string(APPEND h "inline constexpr EngineSineBits kEngineSineBits[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON label GET "${vec}" engine_sine_bits ${i} label)
    string(JSON phase GET "${vec}" engine_sine_bits ${i} phase)
    string(JSON pattern GET "${vec}" engine_sine_bits ${i} bits)
    if(NOT pattern MATCHES "^0x[0-9a-f]+$")
      message(FATAL_ERROR "spec tables: not a hex bit pattern: '${pattern}'")
    endif()
    _arcani_spec_cxx_string(label "${label}")
    _arcani_spec_u64(phase "${phase}")
    string(APPEND h "  {${label}, ${phase}, UINT64_C(${pattern})},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- sine coefficients
  string(JSON n LENGTH "${vec}" sine_coefficients)
  string(APPEND h "inline constexpr Coefficient kSineCoefficients[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON power GET "${vec}" sine_coefficients ${i} power)
    string(JSON hex GET "${vec}" sine_coefficients ${i} hex)
    _arcani_spec_hexf(hex "${hex}")
    string(APPEND h "  {${power}, ${hex}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- thresholds
  string(JSON n LENGTH "${thr}" rows)
  string(APPEND h "inline constexpr Threshold kThresholds[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON id GET "${thr}" rows ${i} id)
    string(JSON value GET "${thr}" rows ${i} value)
    string(JSON unit GET "${thr}" rows ${i} unit)
    _arcani_spec_cxx_string(id "${id}")
    _arcani_spec_decimal(value "${value}")
    _arcani_spec_cxx_string(unit "${unit}")
    string(APPEND h "  {${id}, ${value}, ${unit}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- ranges: Hz rows with a {min, max} value, session length, sample rates
  string(JSON n LENGTH "${rng}" rows)
  math(EXPR last "${n} - 1")
  set(hz_rows "")
  set(session_max "")
  set(session_unit "")
  set(rates "")
  foreach(i RANGE ${last})
    string(JSON id GET "${rng}" rows ${i} id)
    string(JSON unit GET "${rng}" rows ${i} unit)
    string(JSON vtype TYPE "${rng}" rows ${i} value)
    if(vtype STREQUAL "OBJECT")
      string(JSON vmin GET "${rng}" rows ${i} value min)
      string(JSON vmax GET "${rng}" rows ${i} value max)
      _arcani_spec_decimal(vmin "${vmin}")
      _arcani_spec_decimal(vmax "${vmax}")
      if(unit STREQUAL "Hz")
        _arcani_spec_cxx_string(qid "${id}")
        string(APPEND hz_rows "  {${qid}, ${vmin}, ${vmax}},\n")
      endif()
      if(id STREQUAL "session-length")
        set(session_max "${vmax}")
        _arcani_spec_cxx_string(session_unit "${unit}")
      endif()
    elseif(vtype STREQUAL "ARRAY" AND id STREQUAL "sample-rates")
      string(JSON rn LENGTH "${rng}" rows ${i} value)
      math(EXPR rlast "${rn} - 1")
      foreach(k RANGE ${rlast})
        string(JSON r GET "${rng}" rows ${i} value ${k})
        string(APPEND rates "${r}u, ")
      endforeach()
    endif()
  endforeach()
  if(hz_rows STREQUAL "" OR session_max STREQUAL "" OR rates STREQUAL "")
    message(FATAL_ERROR "spec tables: ${ranges_json} lacks Hz ranges, session-length, or sample-rates")
  endif()
  string(APPEND h "inline constexpr HzRange kHzRanges[] = {\n${hz_rows}};\n\n")
  string(APPEND h "inline constexpr double kSessionLengthMax = ${session_max};\n")
  string(APPEND h "inline constexpr const char* kSessionLengthUnit = ${session_unit};\n")
  string(APPEND h "inline constexpr std::uint32_t kSampleRates[] = {${rates}};\n\n")
  string(APPEND h "}  // namespace arcani::test::spec\n")

  # Rewrite only on change, so an unchanged configure does not rebuild tests.
  set(old "")
  if(EXISTS "${out_file}")
    file(READ "${out_file}" old)
  endif()
  if(NOT old STREQUAL h)
    file(WRITE "${out_file}" "${h}")
  endif()
endfunction()

# Script mode: cmake -DOUT=... -DVECTORS=... -DTHRESHOLDS=... -DRANGES=... -P SpecTables.cmake
if(CMAKE_SCRIPT_MODE_FILE AND CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  arcani_generate_spec_tables("${OUT}" "${VECTORS}" "${THRESHOLDS}" "${RANGES}")
endif()
