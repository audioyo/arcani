# Generates a C++ header from the signal spec vectors (Story 0.2), so the C++
# tests never carry a vector as a literal. Input, read at configure time with
# file(READ) and string(JSON):
#
#   tests/data/signal_spec_vectors.json   (tools/signal_spec_vectors.py)
#
# Thresholds and ranges are not generated here: the tests read
# tests/tables/*.tsv at run time through the assertion library
# (tests/assertions/tables.hpp, Story 0.3).
#
# Story 1.2 adds kBlockFrames, kBlocks (internal block size) and kStubChain
# (stub chain samples, one row per fixture, sample rate, and index).
# Story 1.5 adds the theta reference columns to kStubChain: has_theta (false
# when the fixture has no theta_reference field, theta carrier "none"),
# theta_carrier_hz (0.0 then), inc_theta, phase_theta, and theta_bits (the
# theta tap, the same in both channels).
# Story 1.4 adds kQuantize24 (24-bit rounding: rule, case, sample, value, and
# the 3 written bytes in file order).
# Story 2.1 adds the theta reference: kThetaOnSharePercent, kThetaEdgeMs, and
# kThetaHalfOnUnits (H), kRatioToPhase (ratio-to-phase rule), kThetaEdges
# (edge length W per rate), kThetaEnvelopes (engine envelope bits and the
# ideal envelope per shape, rate, and phase), and kThetaSamples (per theta
# fixture, sample rate, and index: phases, e, a, and theta tap bits).
# Story 2.2 adds the gamma PAC layer: kGammaEnvelopes (engine envelope and
# amplitude bits and their ideal values per depth and envelope phase),
# kGammaSamples (per gamma fixture, sample rate, and index: phases, e, a, and
# gamma tap bits; has_theta is false when the fixture has no theta_reference
# field), and kGammaBus (theta-gamma-uncoupled.json: both layers' phases and
# the theta, gamma, and stereo bus bits).
# Story 2.3 adds coupling: kCouplingPhases (coupling phase rule: degrees, x,
# and C), kSwells (engine swell, gamma envelope, and coupled amplitude bits
# and their ideal values per depth, coupling phase, and phases), and
# kSwellSamples (per swell fixture, sample rate, and index: phases, s, e, a,
# and the gamma, theta, and stereo bus bits; has_theta is false without a
# theta_reference field).
# Story 2.4 adds bursts: kBurstWidthMs and kBurstEdgeMs (the fixed constants
# in row units), kBurstEdges (Hb and Wb per theta rate), kBurstGates (the
# engine gate bits and the ideal gate per theta rate, coupling phase, and u,
# with the segment name), kBurstAmplitudes (gate, gamma envelope, and
# amplitude bits and their ideal values per depth, segment, and gamma
# envelope phase), and kBurstSamples (per burst fixture, sample rate, and
# index: segment, phases, g, e, a, and the gamma, theta, and stereo bus bits;
# every burst fixture has a theta reference).
# Story 2.5 adds the binaural layer and rate curve: kInvTwoPi (the binary64
# nearest 1 / (2 pi)) and kSeekSeconds, kCyclesToUnits (cycles-to-units
# rule: v and U), kRateCycles (once-per-plan constants per start phase and
# sample rate: P0, 1 / P, inc_P, s * P, K, and the c0 bits), and
# kBinauralSamples (per binaural fixture, sample rate, and index: phases, the
# cycle cosine c, v, U, the right phase, and the left and right bits;
# has_cycle is false and every cycle column 0 without a beat_rate_cycle
# field). The precise cycle cosine adds kCycleCosineCoefficients (power and
# binary64 value, Horner from the highest) and kCycleCosines (phase and the
# engine cycle cosine bits, with the ideal cosine).
# Story 2.6 adds rate curves on the theta and gamma rates: kLayerRateCycles
# (per rate-curve fixture, curved layer ("theta" or "gamma"), and sample
# rate: center, swing, period, start phase, the lowest and highest rates,
# the envelope increment, P0, 1 / P, inc_P, s * P, K, the c0 bits, and N) and
# kRateCurveSamples (per rate-curve fixture, sample rate, and index: each
# layer's presence and cycle, the increments, W, C, Hb, Wb, the cycle
# constants, the carrier, cycle, and curved envelope phases, U, and the
# swell or gate (has_factor false uncoupled or past the end), theta, gamma,
# and stereo bus bits; every absent column 0).
# Story 2.7 adds the loop: kLoop_* constants (rule names and the whole-sample
# limit, the full-render and probe fixtures, the window and probe segment
# lengths, the probe seam, and both max run times), kLoopWholeSamples (the
# whole-sample rule per time: verdict and n at both rates), kLoopCompileCases
# (per loop fixture: accepted, or the first failing rule's parameter, value,
# rule, and limit; "none" when accepted), and kLoopFrames (per accepted loop
# fixture and sample rate: O, B, N, M, the seams zero-padded to
# kLoopMaxSeams, and the last pass length).
# Story 3.1 adds the components: kComponent_* constants (the level row in dB,
# the threshold as a decimal and as the binary64 nearest it, both error rows,
# the rule name of an unmodeled shape, the case recipe length, and the layer,
# ear, and hash probe case names), kComponentCoefficients (P(k, w), the
# coefficient, and its bound per form, theta rate, and k; has_h, has_p, and
# has_bound are false and the value 0.0 where the column is "none"),
# kComponentCases (per case: name, fixture file or "none", muted ear, a
# complete recipe text, and the row count over both ears), and kComponents
# (the ideal component table of every case in table order: ear "both" marks a
# row that is in the left and in the right table).
#
# Big integers are JSON strings and become UINT64_C literals. Hex float
# strings become C++ hex float literals; "nan", "inf", and "-inf" become
# std::numeric_limits expressions. Decimal sine values become double
# literals. Usable from a CMakeLists.txt and in script mode (cmake -P).

function(_arcani_spec_cxx_string out_var value)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  set(${out_var} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(_arcani_spec_u64 out_var value)
  if(NOT value MATCHES "^[0-9]+$")
    message(FATAL_ERROR "spec tables: not an unsigned integer: '${value}'")
  endif()
  set(${out_var} "UINT64_C(${value})" PARENT_SCOPE)
endfunction()

# A binary64 value written as a hex float, or nan / inf / -inf.
function(_arcani_spec_hexf out_var value)
  if(value STREQUAL "nan")
    set(${out_var} "std::numeric_limits<double>::quiet_NaN()" PARENT_SCOPE)
  elseif(value STREQUAL "inf")
    set(${out_var} "std::numeric_limits<double>::infinity()" PARENT_SCOPE)
  elseif(value STREQUAL "-inf")
    set(${out_var} "(-std::numeric_limits<double>::infinity())" PARENT_SCOPE)
  elseif(value MATCHES "^-?0x[0-9a-f]+(\\.[0-9a-f]*)?p[-+][0-9]+$")
    set(${out_var} "${value}" PARENT_SCOPE)
  else()
    message(FATAL_ERROR "spec tables: not a hex float: '${value}'")
  endif()
endfunction()

# A decimal number (JSON number or decimal string) as a double literal.
function(_arcani_spec_decimal out_var value)
  if(value MATCHES "^-?[0-9]+$")
    set(${out_var} "${value}.0" PARENT_SCOPE)
  elseif(value MATCHES "^-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?$")
    set(${out_var} "${value}" PARENT_SCOPE)
  else()
    message(FATAL_ERROR "spec tables: not a decimal number: '${value}'")
  endif()
endfunction()

function(arcani_generate_spec_tables out_file vectors_json)
  file(READ "${vectors_json}" vec)

  set(h "// Generated by tests/cpp/SpecTables.cmake at configure time. Do not edit.\n")
  get_filename_component(_v "${vectors_json}" NAME)
  string(APPEND h "// Source: ${_v}\n")
  string(APPEND h "#pragma once\n\n#include <cstddef>\n#include <cstdint>\n#include <limits>\n\n")
  string(APPEND h "namespace arcani::test::spec {\n\n")
  string(APPEND h "struct IncrementVector { const char* label; double f_hz; std::uint32_t fs; std::uint64_t inc; };\n")
  string(APPEND h "struct SamplesVector { const char* label; double t_s; std::uint32_t fs; std::uint64_t n; };\n")
  string(APPEND h "struct PhaseStepVector { const char* label; std::uint64_t start; std::uint64_t inc; std::uint64_t steps; std::uint64_t phase; };\n")
  string(APPEND h "struct SineVector { const char* label; std::uint64_t phase; double sine; };\n")
  string(APPEND h "struct CarrierSample { std::uint64_t n; std::uint64_t phase; double sine; };\n")
  string(APPEND h "struct Coefficient { int power; double value; };\n")
  string(APPEND h "struct EngineSineBits { const char* label; std::uint64_t phase; std::uint64_t bits; };\n")
  string(APPEND h "struct BlockVector { std::uint64_t frame; std::uint64_t block; std::uint64_t offset; };\n")
  string(APPEND h "struct Quantize24Vector { const char* rule; const char* label; double s; std::int32_t value; std::uint8_t bytes[3]; };\n")
  string(APPEND h "struct StubChainVector { const char* fixture; bool past_end; std::uint32_t fs; double carrier_left_hz; double beat_rate_hz; double carrier_right_hz; std::uint64_t inc_left; std::uint64_t inc_right; std::uint64_t frames; std::uint64_t n; std::uint64_t phase_left; std::uint64_t phase_right; std::uint64_t left_bits; std::uint64_t right_bits; bool has_theta; double theta_carrier_hz; std::uint64_t inc_theta; std::uint64_t phase_theta; std::uint64_t theta_bits; };\n")
  string(APPEND h "struct RatioToPhaseVector { const char* label; double r; std::uint64_t phase; };\n")
  string(APPEND h "struct ThetaEdgeVector { double rate_hz; std::uint64_t w_units; };\n")
  string(APPEND h "struct ThetaEnvelopeVector { const char* shape; const char* segment; double rate_hz; std::uint64_t w_units; std::uint64_t h_units; std::uint64_t phase; std::uint64_t e_bits; double ideal_e; };\n")
  string(APPEND h "struct ThetaSampleVector { const char* fixture; bool past_end; std::uint32_t fs; const char* shape; double carrier_hz; double rate_hz; double depth_percent; double length_s; std::uint64_t inc_carrier; std::uint64_t inc_rate; std::uint64_t w_units; std::uint64_t h_units; std::uint64_t frames; std::uint64_t n; std::uint64_t phase_carrier; std::uint64_t phase_rate; std::uint64_t e_bits; std::uint64_t a_bits; std::uint64_t theta_bits; };\n")
  string(APPEND h "struct GammaEnvelopeVector { double depth_percent; std::uint64_t phase; std::uint64_t e_bits; std::uint64_t a_bits; double ideal_e; double ideal_a; };\n")
  string(APPEND h "struct GammaSampleVector { const char* fixture; bool past_end; std::uint32_t fs; bool has_theta; double carrier_hz; double rate_hz; double depth_percent; double length_s; std::uint64_t inc_carrier; std::uint64_t inc_rate; std::uint64_t frames; std::uint64_t n; std::uint64_t phase_carrier; std::uint64_t phase_rate; std::uint64_t e_bits; std::uint64_t a_bits; std::uint64_t gamma_bits; };\n")
  string(APPEND h "struct GammaBusVector { const char* fixture; bool past_end; std::uint32_t fs; std::uint64_t n; std::uint64_t phase_theta; std::uint64_t phase_theta_envelope; std::uint64_t phase_gamma; std::uint64_t phase_gamma_envelope; std::uint64_t theta_bits; std::uint64_t gamma_bits; std::uint64_t bus_bits; };\n")
  string(APPEND h "struct CouplingPhaseVector { double deg; double x; std::uint64_t c_units; };\n")
  string(APPEND h "struct SwellVector { double depth_percent; double deg; std::uint64_t c_units; std::uint64_t phase_theta_envelope; std::uint64_t phase_gamma_envelope; std::uint64_t s_bits; std::uint64_t e_bits; std::uint64_t a_bits; double ideal_s; double ideal_a; };\n")
  string(APPEND h "struct SwellSampleVector { const char* fixture; bool past_end; std::uint32_t fs; bool has_theta; double carrier_hz; double rate_hz; double depth_percent; double coupling_phase_deg; double length_s; std::uint64_t c_units; std::uint64_t inc_carrier; std::uint64_t inc_rate; std::uint64_t inc_theta_envelope; std::uint64_t frames; std::uint64_t n; std::uint64_t phase_carrier; std::uint64_t phase_rate; std::uint64_t phase_theta_envelope; std::uint64_t s_bits; std::uint64_t e_bits; std::uint64_t a_bits; std::uint64_t gamma_bits; std::uint64_t theta_bits; std::uint64_t bus_bits; };\n")
  string(APPEND h "struct BurstEdgeVector { double rate_hz; std::uint64_t hb_units; std::uint64_t wb_units; };\n")
  string(APPEND h "struct BurstGateVector { const char* segment; double rate_hz; double deg; std::uint64_t c_units; std::uint64_t hb_units; std::uint64_t wb_units; std::uint64_t phase_theta_envelope; std::uint64_t u; std::uint64_t g_bits; double ideal_g; };\n")
  string(APPEND h "struct BurstAmplitudeVector { const char* segment; double depth_percent; double rate_hz; std::uint64_t phase_theta_envelope; std::uint64_t phase_gamma_envelope; std::uint64_t g_bits; std::uint64_t e_bits; std::uint64_t a_bits; double ideal_g; double ideal_a; };\n")
  string(APPEND h "struct BurstSampleVector { const char* fixture; bool past_end; std::uint32_t fs; const char* segment; double carrier_hz; double rate_hz; double depth_percent; double coupling_phase_deg; double length_s; double theta_carrier_hz; double theta_rate_hz; double theta_depth_percent; std::uint64_t c_units; std::uint64_t hb_units; std::uint64_t wb_units; std::uint64_t inc_carrier; std::uint64_t inc_rate; std::uint64_t inc_theta_envelope; std::uint64_t frames; std::uint64_t n; std::uint64_t phase_carrier; std::uint64_t phase_rate; std::uint64_t phase_theta_envelope; std::uint64_t g_bits; std::uint64_t e_bits; std::uint64_t a_bits; std::uint64_t gamma_bits; std::uint64_t theta_bits; std::uint64_t bus_bits; };\n")
  string(APPEND h "struct CycleCosineVector { const char* label; std::uint64_t phase; std::uint64_t bits; double ideal; };\n")
  string(APPEND h "struct CyclesToUnitsVector { const char* label; double v; std::uint64_t units; };\n")
  string(APPEND h "struct RateCycleVector { double swing_hz; double period_s; double start_phase_deg; double x; std::uint64_t p0; double inv_period; std::uint32_t fs; std::uint64_t inc_cycle; double swing_period; double k; std::uint64_t c0_bits; };\n")
  string(APPEND h "struct BinauralSampleVector { const char* fixture; bool past_end; std::uint32_t fs; bool has_cycle; double carrier_left_hz; double beat_rate_hz; double center_hz; double swing_hz; double period_s; double start_phase_deg; double length_s; std::uint64_t inc_left; std::uint64_t inc_center; std::uint64_t p0; std::uint64_t inc_cycle; double k; std::uint64_t frames; std::uint64_t n; std::uint64_t phase_left; std::uint64_t phase_center; std::uint64_t phase_cycle; std::uint64_t c_bits; std::uint64_t v_bits; std::uint64_t u_units; std::uint64_t phase_right; std::uint64_t left_bits; std::uint64_t right_bits; };\n")
  string(APPEND h "struct LayerRateCycleVector { const char* fixture; const char* layer; std::uint32_t fs; double center_hz; double swing_hz; double period_s; double start_phase_deg; double lowest_hz; double highest_hz; std::uint64_t inc_rate; std::uint64_t p0; double inv_period; std::uint64_t inc_cycle; double swing_period; double k; std::uint64_t c0_bits; std::uint64_t frames; };\n")
  string(APPEND h "struct RateCurveSampleVector { const char* fixture; bool past_end; std::uint32_t fs; bool has_theta; bool theta_cycle; bool has_gamma; bool gamma_cycle; const char* theta_shape; const char* coupling; std::uint64_t frames; std::uint64_t n; std::uint64_t inc_theta; std::uint64_t inc_theta_envelope; std::uint64_t inc_gamma; std::uint64_t inc_gamma_envelope; std::uint64_t w_units; std::uint64_t c_units; std::uint64_t hb_units; std::uint64_t wb_units; std::uint64_t theta_p0; std::uint64_t theta_inc_cycle; double theta_k; std::uint64_t gamma_p0; std::uint64_t gamma_inc_cycle; double gamma_k; std::uint64_t phase_theta; std::uint64_t theta_cycle_phase; std::uint64_t theta_u; std::uint64_t phase_theta_envelope; std::uint64_t phase_gamma; std::uint64_t gamma_cycle_phase; std::uint64_t gamma_u; std::uint64_t phase_gamma_envelope; bool has_factor; std::uint64_t factor_bits; std::uint64_t theta_bits; std::uint64_t gamma_bits; std::uint64_t bus_bits; };\n")
  string(APPEND h "struct LoopWholeSampleVector { double t_s; bool whole; std::uint64_t n_44100; std::uint64_t n_48000; };\n")
  string(APPEND h "struct LoopCompileVector { const char* fixture; bool accepted; const char* parameter; const char* value; const char* rule; const char* limit; };\n")
  string(APPEND h "inline constexpr std::size_t kLoopMaxSeams = 32;\n")
  string(APPEND h "struct LoopFrameVector { const char* fixture; std::uint32_t fs; std::uint64_t opening_end_frame; std::uint64_t body_frames; std::uint64_t end_frame; std::uint64_t seam_count; std::uint64_t seams[kLoopMaxSeams]; std::uint64_t last_pass_frames; };\n\n")

  # ---- increments
  string(JSON n LENGTH "${vec}" increments)
  string(APPEND h "inline constexpr IncrementVector kIncrements[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON label GET "${vec}" increments ${i} label)
    string(JSON case GET "${vec}" increments ${i} case)
    string(JSON f GET "${vec}" increments ${i} f_hex)
    string(JSON fs GET "${vec}" increments ${i} fs)
    string(JSON inc GET "${vec}" increments ${i} inc)
    _arcani_spec_cxx_string(label "${case}: ${label}")
    _arcani_spec_hexf(f "${f}")
    _arcani_spec_u64(inc "${inc}")
    string(APPEND h "  {${label}, ${f}, ${fs}u, ${inc}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- samples
  string(JSON n LENGTH "${vec}" samples)
  string(APPEND h "inline constexpr SamplesVector kSamples[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON label GET "${vec}" samples ${i} label)
    string(JSON case GET "${vec}" samples ${i} case)
    string(JSON t GET "${vec}" samples ${i} t_hex)
    string(JSON fs GET "${vec}" samples ${i} fs)
    string(JSON count GET "${vec}" samples ${i} n)
    _arcani_spec_cxx_string(label "${case}: ${label}")
    _arcani_spec_hexf(t "${t}")
    _arcani_spec_u64(count "${count}")
    string(APPEND h "  {${label}, ${t}, ${fs}u, ${count}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- phase steps
  string(JSON n LENGTH "${vec}" phase_steps)
  string(APPEND h "inline constexpr PhaseStepVector kPhaseSteps[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON label GET "${vec}" phase_steps ${i} label)
    string(JSON start GET "${vec}" phase_steps ${i} start)
    string(JSON inc GET "${vec}" phase_steps ${i} inc)
    string(JSON steps GET "${vec}" phase_steps ${i} steps)
    string(JSON phase GET "${vec}" phase_steps ${i} phase)
    _arcani_spec_cxx_string(label "${label}")
    _arcani_spec_u64(start "${start}")
    _arcani_spec_u64(inc "${inc}")
    _arcani_spec_u64(steps "${steps}")
    _arcani_spec_u64(phase "${phase}")
    string(APPEND h "  {${label}, ${start}, ${inc}, ${steps}, ${phase}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- exact phases
  string(JSON n LENGTH "${vec}" exact_phases)
  string(APPEND h "inline constexpr SineVector kExactPhases[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON label GET "${vec}" exact_phases ${i} label)
    string(JSON phase GET "${vec}" exact_phases ${i} phase)
    string(JSON sine GET "${vec}" exact_phases ${i} sine)
    _arcani_spec_cxx_string(label "${label}")
    _arcani_spec_u64(phase "${phase}")
    _arcani_spec_decimal(sine "${sine}")
    string(APPEND h "  {${label}, ${phase}, ${sine}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- 450 Hz carrier at 44.1 kHz
  string(JSON c_label GET "${vec}" carrier_450_44100 label)
  string(JSON c_f GET "${vec}" carrier_450_44100 f_hz)
  string(JSON c_fs GET "${vec}" carrier_450_44100 fs)
  string(JSON c_inc GET "${vec}" carrier_450_44100 inc)
  _arcani_spec_cxx_string(c_label "${c_label}")
  _arcani_spec_decimal(c_f "${c_f}")
  _arcani_spec_u64(c_inc "${c_inc}")
  string(APPEND h "inline constexpr const char* kCarrierLabel = ${c_label};\n")
  string(APPEND h "inline constexpr double kCarrierHz = ${c_f};\n")
  string(APPEND h "inline constexpr std::uint32_t kCarrierFs = ${c_fs}u;\n")
  string(APPEND h "inline constexpr std::uint64_t kCarrierInc = ${c_inc};\n")
  string(JSON n LENGTH "${vec}" carrier_450_44100 samples)
  string(APPEND h "inline constexpr CarrierSample kCarrierSamples[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON sn GET "${vec}" carrier_450_44100 samples ${i} n)
    string(JSON phase GET "${vec}" carrier_450_44100 samples ${i} phase)
    string(JSON sine GET "${vec}" carrier_450_44100 samples ${i} sine)
    _arcani_spec_u64(sn "${sn}")
    _arcani_spec_u64(phase "${phase}")
    _arcani_spec_decimal(sine "${sine}")
    string(APPEND h "  {${sn}, ${phase}, ${sine}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- engine sine bits (spec algorithm in binary64, exact operation order)
  string(JSON n LENGTH "${vec}" engine_sine_bits)
  string(APPEND h "inline constexpr EngineSineBits kEngineSineBits[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON label GET "${vec}" engine_sine_bits ${i} label)
    string(JSON phase GET "${vec}" engine_sine_bits ${i} phase)
    string(JSON pattern GET "${vec}" engine_sine_bits ${i} bits)
    if(NOT pattern MATCHES "^0x[0-9a-f]+$")
      message(FATAL_ERROR "spec tables: not a hex bit pattern: '${pattern}'")
    endif()
    _arcani_spec_cxx_string(label "${label}")
    _arcani_spec_u64(phase "${phase}")
    string(APPEND h "  {${label}, ${phase}, UINT64_C(${pattern})},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- sine coefficients
  string(JSON n LENGTH "${vec}" sine_coefficients)
  string(APPEND h "inline constexpr Coefficient kSineCoefficients[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON power GET "${vec}" sine_coefficients ${i} power)
    string(JSON hex GET "${vec}" sine_coefficients ${i} hex)
    _arcani_spec_hexf(hex "${hex}")
    string(APPEND h "  {${power}, ${hex}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- internal block size (Story 1.2)
  string(JSON block_frames GET "${vec}" block_frames)
  _arcani_spec_u64(block_frames "${block_frames}")
  string(APPEND h "inline constexpr std::uint64_t kBlockFrames = ${block_frames};\n")
  string(JSON n LENGTH "${vec}" blocks)
  string(APPEND h "inline constexpr BlockVector kBlocks[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON frame GET "${vec}" blocks ${i} frame)
    string(JSON block GET "${vec}" blocks ${i} block)
    string(JSON offset GET "${vec}" blocks ${i} offset)
    _arcani_spec_u64(frame "${frame}")
    _arcani_spec_u64(block "${block}")
    _arcani_spec_u64(offset "${offset}")
    string(APPEND h "  {${frame}, ${block}, ${offset}},\n")
  endforeach()
  string(APPEND h "};\n\n")

  # ---- stub chain samples (Story 1.2)
  string(JSON n LENGTH "${vec}" stub_chain)
  string(APPEND h "inline constexpr StubChainVector kStubChain[] = {\n")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    set(_fields "")
    string(JSON fixture GET "${vec}" stub_chain ${i} fixture)
    string(JSON case GET "${vec}" stub_chain ${i} case)
    string(JSON fs GET "${vec}" stub_chain ${i} fs)
    _arcani_spec_cxx_string(fixture "${fixture}")
    if(case STREQUAL "past_end")
      set(past "true")
